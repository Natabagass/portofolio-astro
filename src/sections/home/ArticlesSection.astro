---
import Text from "@components/react/Typography";

const data = [
    {
        id: 1,
        date: '25 March 2024',
        isoDate: '2024-03-25',
        url: '5-ways-of-adaptability-in-bangkit-academy-2024',
        title: '5 Ways of Adaptability in Bangkit Academy 2024'
    },
    {
        id: 2,
        date: '7 September 2024',
        isoDate: '2024-09-07',
        url: 'building-a-project-with-astro',
        title: 'Building a Project With Astro'
    },
]
---

<section class="mt-12 overflow-hidden rounded-3xl border border-white/10 bg-[#1C1C1C30] shadow-inner" aria-labelledby="articles-title">
    <div class="flex w-full flex-row items-center justify-between gap-4 p-6 sm:p-8">
        <Text size="h2" Type="h2" weight="font-medium">
            <span id="articles-title">Articles</span>
        </Text>
        <a href="/blogs" class="rounded-full border border-white/10 bg-secondary/50 px-4 py-2 text-sm text-white transition-colors hover:border-pink-200/50 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-pink-200">
            All Articles
        </a>
    </div>
    <div class="bg-secondary/50 px-6 sm:px-8">
        {
            data.map((item) => (
                <a href={`/blogs/${item.url}`} class="article-link group flex w-full flex-col gap-2 border-t border-white/10 py-5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-pink-200 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
                    <Text size="p2" color="text-gray-100" Type="h3" weight="font-medium" className="transition-colors group-hover:text-pink-200">
                        {item.title}
                    </Text>
                    <time datetime={item.isoDate} class="shrink-0 text-sm text-subtitle">{item.date}</time>
                </a>
            ))
        }
    </div>    
</section>
