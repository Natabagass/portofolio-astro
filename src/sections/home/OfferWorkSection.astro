---
import Links from "@components/react/Links";
import Text from "@components/react/Typography";

---

<section class="mt-14 w-full overflow-hidden rounded-3xl border border-white/10 bg-[#1C1C1C30] shadow-inner" aria-labelledby="contact-title">
    <div class="flex flex-col gap-6 bg-secondary/50 p-6 sm:p-9 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
            <Text size="h2" weight="font-normal" Type="h2">
                <span id="contact-title">Have a product to build?</span>
            </Text>
            <Text size="h2" weight="font-medium" Type="p" color="text-pink-200" className="mt-1">
                Let’s make it useful.
            </Text>
            <Text size="p2" weight="font-normal" Type="p" color="text-gray-200" className="mt-4 max-w-xl">
                I build frontend experiences for products, internal tools, and independent projects.
            </Text>
        </div>
        <Links
            variant="primary"
            padding="px-6 py-3"
            className="w-fit text-base text-[#1A1A1A] shadow-buttonPink transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pink-200"
            href="mailto:meganatabagas@gmail.com"
        >
            Start a project
        </Links>
    </div>
    <div class="grid gap-6 px-6 py-6 sm:grid-cols-2 sm:px-9">
        <div class="flex flex-col gap-1">
            <Text size="p3" weight="font-normal" color="text-subtitle" Type="p">Email</Text>
            <a class="w-fit text-gray-100 transition-colors hover:text-pink-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-pink-200" href="mailto:meganatabagas@gmail.com">
                meganatabagas@gmail.com
            </a>
        </div>
        <div class="flex flex-col gap-1">
            <Text size="p3" weight="font-normal" color="text-subtitle" Type="p">Find me</Text>
            <div class="flex flex-row gap-4 text-gray-100">
                <a class="transition-colors hover:text-pink-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-pink-200" target="_blank" rel="noreferrer" href="https://github.com/Natabagass">
                    Github
                </a>
                <a class="transition-colors hover:text-pink-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-pink-200" target="_blank" rel="noreferrer" href="https://www.linkedin.com/in/natabagass/">
                    LinkedIn
                </a>
            </div>
        </div>
    </div>
</section>
