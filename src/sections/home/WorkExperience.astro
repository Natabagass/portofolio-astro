---
import Text from "@components/react/Typography";

const data = [
    {
        id: 1,
        date: 'Oct 2026 - Present',
        job: 'Dealls.com',
        role: 'Lead Frontend Developer',
        active: true,
        desc: 'Lead frontend delivery by prioritizing sprint work, assigning tasks, resolving user-reported issues, and delivering advertising features. Review code and build AI agent workflows that follow project standards.'
    },
    {
        id: 2,
        date: 'Feb 2026 - Oct 2026',
        job: 'Dealls.com',
        role: 'Frontend Developer',
        active: false,
        desc: 'Developed HRIS features and AI-assisted workflows for employee tasks. Contributed to fast-paced projects including gydmun.org and internal products.'
    },
    {
        id: 3,
        date: 'Feb 2025 - Sep 2025',
        job: 'Indonesia Crypto Network',
        role: 'Frontend Developer',
        active: false,
        desc: 'Built an AI article-generation website and an automated publishing bot for Strapi. Maintained Coinfest Asia marketing pages and developed the Asosiasi Blockchain Indonesia website.'
    },
    {
        id: 4,
        date: 'Oct 2023 - Dec 2024',
        job: 'Cashplus',
        type: 'Fulltime',
        active: false,
        desc: 'Cashplus is a platform for digital payment transaction. Including money transfer, H2H, credit, internet packages, PPOB, and game vouchers'
    },
    {
        id: 5,
        date: 'Apr 2023 - Oct 2024',
        job: 'Softease Studio',
        type: 'Parttime',
        active: false,
        desc: 'SoftEase Studio is a multi-platform digital studio capable of facilitating all business digital needs.'
    },
    {
        id: 6,
        date: 'Nov 2022 - Feb 2023',
        job: 'Torche Education',
        type: 'Internship',
        active: false,
        desc: 'Torche Education is a Startup Education Technology that help you learn in the field of engineering, especially in the field of Chemical Engineering.'
    },
]
---

<section class="mt-12 overflow-hidden rounded-3xl border border-white/10 bg-[#1C1C1C30] shadow-inner" aria-labelledby="work-experiences-title">
    <div class="p-6 sm:p-8">
        <Text size="h2" Type="h2" weight="font-medium">
            <span id="work-experiences-title">Work Experiences</span>
        </Text>
    </div>
    <div class="bg-secondary/50 px-6 sm:px-8">
        <ol class="divide-y divide-white/10">
            {data.map((item) => (
                <li class="grid gap-3 py-6 md:grid-cols-[minmax(11rem,0.8fr)_minmax(0,1.2fr)] md:gap-x-6 lg:grid-cols-[14rem_15rem_minmax(0,1fr)] lg:gap-x-8">
                    <div class="flex items-start gap-3">
                        <span class={`${item.id === 1 ? 'bg-pink-200 shadow-[0_0_16px_rgba(243,202,246,0.45)]' : 'bg-white/30'} mt-1.5 h-3 w-3 shrink-0 rounded-full`} aria-hidden="true" />
                        <Text size="p3" Type="time" weight="font-medium" className="text-gray-100">
                            {item.date}
                        </Text>
                    </div>
                    <div class="flex flex-col gap-1 md:col-start-2 lg:col-start-auto">
                        <Text size="p2" Type="h3" weight="font-medium">
                            {item.job}
                        </Text>
                        <Text size="cpt1" Type="p" weight="font-medium" color="text-pink-200">
                            {item.role ?? item.type}
                        </Text>
                    </div>
                    <p class="text-sm leading-6 text-subtitle md:col-start-2 lg:col-start-auto">
                        {item.desc}
                    </p>
                </li>
            ))}
        </ol>
    </div>    
</section>
