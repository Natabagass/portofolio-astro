---
import Text from "@components/react/Typography";
import AllignmentLayout from "@layouts/AlignmentLayout";
import Layout from "@layouts/Layout.astro";
import ShowcaseProject from "@sections/projects/ShowcaseProject.astro";
---

<Layout title="Projects" description="Selected frontend projects and product work by Bagas Meganata, from early MVPs to full-scale web applications.">
    <AllignmentLayout>
        <div class="mt-36 w-full max-w-3xl">
            <Text size="h1" Type="h1" weight="font-medium">
                Projects
            </Text> 
            <Text size="p2 md:p1" weight="font-normal" Type="p" color="text-gray-200" className="mt-4 max-w-2xl leading-relaxed">
                Selected products and features I’ve helped build, from early MVPs to full-scale web applications.
            </Text>   
        </div>
    </AllignmentLayout>
    <AllignmentLayout variant="sub-layout">
        <ShowcaseProject />
    </AllignmentLayout>
</Layout>
