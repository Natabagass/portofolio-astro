---
import "@fontsource/urbanist";
import '../style/style.css';
import Layout from "./Layout.astro";
import AllignmentLayout from "./AlignmentLayout";
import Text from "@components/react/Typography";


const { frontmatter } = Astro.props;

---


<Layout title={frontmatter.title} description={`An article by Bagas Meganata: ${frontmatter.title}`}>
    <AllignmentLayout>
        <article class="blog-content mt-36 text-white">
            <Text size="h1" weight="font-medium">
                {frontmatter.title}
            </Text>
            <div class="mt-6 flex w-full flex-wrap gap-3">
                {
                    frontmatter.tag.map((item: { name: string, id: number }) => (
                        <div class="rounded-full border border-white/10 bg-secondary/50 px-4 py-2 shadow-inner">
                            <Text size="p3" weight="font-normal" className="font-inter" >
                                {item.name}
                            </Text>
                        </div>
                    ))
                }
            </div>
            <div class="blog-content__body mt-8 font-inter">
                <slot />
            </div>
        </article>
    </AllignmentLayout>
</Layout>
